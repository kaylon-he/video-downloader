# 下载产物目录。生产环境建议使用绝对路径并挂载到独立磁盘。
DOWNLOAD_DIR=storage

# 同时运行的下载任务数。公网部署前不要调太大。
MAX_CONCURRENT_DOWNLOADS=1

# URL 最大长度。当前代码使用固定默认值，保留该项用于后续配置化。
MAX_URL_LENGTH=2048

# 个人自用登录态：仅在明确开启时将本地 cookies 文件传给 yt-dlp。
# 不要提交真实 cookies 文件。
# 与 YTDLP_COOKIES_FROM_BROWSER 不能同时使用。
YTDLP_COOKIES_ENABLED=false
YTDLP_COOKIES_PATH=/absolute/path/to/cookies.txt

# 或者直接读取本机浏览器登录态，例如 chrome / firefox / safari。
# 与 YTDLP_COOKIES_ENABLED=true 不能同时使用。
# 本机 Chrome 已登录 YouTube / X 时，开发环境可设置为 chrome。
YTDLP_COOKIES_FROM_BROWSER=
